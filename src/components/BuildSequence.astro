---
// Pinned, scroll-scrubbed intro: the project's own photograph is built up from the ground in 3D,
// slab by slab, while the camera swings from an oblique site view to square-on.
import { Picture, getImage } from 'astro:assets';
import type { Media } from '../lib/images';

interface Props {
  cover: Extract<Media, { kind: 'image' }>;
  /** Large heading over the image (the project title, or the studio name on the home page). */
  heading: string;
  kicker?: string;
  tagLeft?: string;
  tagRight?: string;
  alt: string;
  /** Home page variant: larger heading and a shorter scroll. */
  home?: boolean;
}
const { cover, heading, kicker, tagLeft, tagRight, alt, home = false } = Astro.props;
const texture = await getImage({ src: cover.src, width: Math.min(2048, cover.src.width), format: 'webp' });
const stages = ['Site', 'Structure', 'Enclosure', 'Complete'];
---

<section
  class:list={['seq dark', home && 'seq--home']}
  data-sequence
  data-texture={texture.src}
  data-ratio={cover.ratio.toFixed(4)}
>
  <div class="seq__sticky">
    <div class="seq__frame">
      <div class="seq__photo" data-photo>
        <Picture
          src={cover.src}
          alt={alt}
          formats={['avif', 'webp']}
          widths={[800, 1280, 1920, 2560].filter((w) => w <= cover.src.width).concat(cover.src.width < 2560 ? [cover.src.width] : [])}
          sizes={`(orientation: portrait) ${Math.round(cover.ratio * 110)}vh, 100vw`}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="seq__scene" data-scene data-cursor="Drag"></div>
      <div class="seq__shade" data-shade aria-hidden="true"></div>

      {tagLeft && <span class="seq__tag seq__tag--tl mono">{tagLeft}</span>}
      {tagRight && <span class="seq__tag seq__tag--tr mono">{tagRight}</span>}

      <div class="seq__title">
        {kicker && <p class="mono seq__kicker">{kicker}</p>}
        <h1 class="seq__name">{heading}</h1>
      </div>

      <div class="seq__steps mono" aria-hidden="true">
        {
          stages.map((s, i) => (
            <span data-step={i}>
              {String(i + 1).padStart(2, '0')} {s}
            </span>
          ))
        }
      </div>
      <div class="seq__bar" aria-hidden="true"><span data-bar></span></div>
    </div>
  </div>
</section>

<script>
  import { mountAssembly, reducedMotion, stageAt } from '../scripts/assemble';

  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const range = (p: number, a: number, b: number) => clamp((p - a) / (b - a));

  for (const seq of document.querySelectorAll<HTMLElement>('[data-sequence]')) {
    if (reducedMotion()) {
      seq.classList.add('is-static');
      continue;
    }
    const scene = seq.querySelector<HTMLElement>('[data-scene]')!;
    const photo = seq.querySelector<HTMLElement>('[data-photo]')!;
    const shade = seq.querySelector<HTMLElement>('[data-shade]')!;
    const bar = seq.querySelector<HTMLElement>('[data-bar]')!;
    const steps = [...seq.querySelectorAll<HTMLElement>('[data-step]')];

    const assembly = mountAssembly(scene, { src: seq.dataset.texture!, ratio: Number(seq.dataset.ratio) });

    const onScroll = () => {
      const r = seq.getBoundingClientRect();
      const p = clamp(-r.top / Math.max(1, r.height - innerHeight));
      assembly.setProgress(p);
      const stage = stageAt(p);
      steps.forEach((s, i) => s.classList.toggle('is-on', i <= stage));
      // Hand over to the sharp HTML image once the camera is square-on.
      const done = range(p, 0.93, 0.99);
      photo.style.opacity = String(done);
      scene.style.opacity = String(1 - done);
      scene.style.pointerEvents = done > 0.5 ? 'none' : '';
      shade.style.opacity = String(range(p, 0.6, 0.95));
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    onScroll();
  }
</script>

<style>
  .seq {
    position: relative;
    height: 380vh;
  }
  .seq--home {
    height: 300vh;
  }
  .seq__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
  }
  .seq__frame {
    position: relative;
    height: 100%;
    overflow: hidden;
  }
  .seq__scene,
  .seq__photo {
    position: absolute;
    inset: 0;
  }
  .seq__scene {
    touch-action: pan-y;
  }
  .seq__photo {
    opacity: 0;
  }
  .seq__photo :global(picture),
  .seq__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .seq__shade {
    position: absolute;
    inset: 0;
    opacity: 0;
    background:
      linear-gradient(to top, rgba(5, 5, 5, 0.85) 0%, rgba(5, 5, 5, 0) 45%),
      linear-gradient(to bottom, rgba(5, 5, 5, 0.5) 0%, rgba(5, 5, 5, 0) 20%);
    pointer-events: none;
  }
  .seq__tag {
    position: absolute;
    z-index: 2;
    top: 76px;
    color: var(--white);
  }
  .seq__tag--tl {
    left: var(--gutter);
  }
  .seq__tag--tr {
    right: var(--gutter);
  }
  .seq__title {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(52px, 6vw, 80px);
    pointer-events: none;
  }
  .seq__kicker {
    margin: 0 0 12px;
  }
  .seq__name {
    margin: 0 0 0 -0.04em;
    font-weight: 900;
    font-size: clamp(48px, 9vw, 180px);
    line-height: 0.86;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }
  .seq--home .seq__name {
    font-size: clamp(120px, 31vw, 560px);
    line-height: 0.74;
    letter-spacing: -0.075em;
  }
  .seq__steps {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 18px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .seq__steps span {
    opacity: 0.35;
    transition: opacity 0.5s;
  }
  .seq__steps span.is-on {
    opacity: 1;
  }
  .seq__bar {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--line-dark);
  }
  .seq__bar span {
    display: block;
    height: 100%;
    background: var(--white);
    transform-origin: left;
    transform: scaleX(0);
  }

  /* Reduced motion: just the photograph */
  .seq.is-static {
    height: 100vh;
  }
  .seq.is-static .seq__photo,
  .seq.is-static .seq__shade {
    opacity: 1;
  }
  .seq.is-static .seq__steps,
  .seq.is-static .seq__bar {
    display: none;
  }

  @media (max-width: 760px) {
    .seq {
      height: 300vh;
    }
    .seq__tag--tr {
      display: none;
    }
    .seq__steps {
      font-size: 9px;
    }
  }
</style>
