---
import { site } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="footer dark" id="contact">
  <div class="wrap footer__top">
    <p class="mono footer__kicker">( Contact )</p>
    <a href={`mailto:${site.email}`} class="footer__cta">
      <span class="mask"><span>Let's build</span></span>
      <span class="mask"><span>something <em>solid.</em></span></span>
    </a>
  </div>

  <div class="wrap footer__grid mono">
    <div>
      <p class="footer__label">Studio</p>
      <p>{site.name}<br />{site.location}</p>
    </div>
    <div>
      <p class="footer__label">Principal</p>
      <p>{site.principal}<br />{site.principalTitle}</p>
    </div>
    <div>
      <p class="footer__label">Enquiries</p>
      <p><a class="link" href={`mailto:${site.email}`}>{site.email}</a><br /><a class="link" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></p>
    </div>
    <div>
      <p class="footer__label">Follow</p>
      <p><a class="link" href={site.instagram} target="_blank" rel="noopener">Instagram</a><br /><a class="link" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></p>
    </div>
  </div>

  <div class="footer__word" aria-hidden="true">{site.short}</div>

  <div class="wrap footer__base mono">
    <span>© {year} {site.name}</span>
    <a href="#main" class="link">Back to top ↑</a>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-top: clamp(100px, 16vw, 220px);
    overflow: hidden;
    border-top: 1px solid var(--line-dark);
  }
  .footer__kicker {
    margin: 0 0 28px;
    color: var(--grey);
  }
  .footer__cta {
    display: block;
    font-weight: 800;
    font-size: clamp(48px, 10vw, 170px);
    line-height: 0.9;
    letter-spacing: -0.055em;
    transition: opacity 0.4s;
  }
  .footer__cta em {
    font-style: normal;
    font-weight: 300;
  }
  .footer__cta:hover {
    opacity: 0.6;
  }
  .footer__cta .mask:nth-child(2) > span {
    transition-delay: 0.08s;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: clamp(80px, 12vw, 160px);
    padding-block: 28px;
    border-top: 1px solid var(--line-dark);
  }
  .footer__grid p {
    margin: 0;
  }
  .footer__label {
    color: var(--grey);
    margin-bottom: 10px !important;
  }
  .footer__word {
    font-weight: 900;
    font-size: 42vw;
    letter-spacing: -0.065em;
    line-height: 0.75;
    white-space: nowrap;
    text-align: center;
    margin-top: 40px;
    color: transparent;
    -webkit-text-stroke: 1px var(--white);
    opacity: 0.9;
    user-select: none;
  }
  .footer__base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px;
    color: var(--grey);
  }
  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 32px;
    }
  }
</style>
