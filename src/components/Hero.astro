---
// Home hero: full-bleed project photography, cross-fading slide to slide.
import { Picture } from 'astro:assets';
import { coverOf, roleOf, type Project } from '../lib/projects';
import { site } from '../site.config';

interface Props {
  projects: Project[];
}
// Featured projects with photography first, then any others with photography.
const slides = Astro.props.projects
  .map((p) => ({ p, cover: coverOf(p) }))
  .filter((s) => s.cover)
  .sort((a, b) => Number(b.p.data.featured) - Number(a.p.data.featured))
  .slice(0, 7);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="hero dark" data-hero aria-label="Selected work">
  <div class="hero__stage">
    {
      slides.map(({ p, cover }, i) => (
        <figure class:list={['slide', i === 0 && 'is-on']} data-slide={i}>
          <Picture
            src={cover!.src}
            alt={`${p.data.title}, ${p.data.location}`}
            formats={['avif', 'webp']}
            widths={[960, 1440, 1920, 2560].filter((w) => w <= cover!.src.width).concat(cover!.src.width < 2560 ? [cover!.src.width] : [])}
            sizes={`(orientation: portrait) ${Math.round(cover!.ratio * 110)}vh, 100vw`}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </figure>
      ))
    }
    <div class="hero__shade" aria-hidden="true"></div>
  </div>

  <div class="hero__foot wrap">
    <div class="hero__id">
      <h1 class="hero__title">
        <span class="mask"><span>{site.name}</span></span>
      </h1>
      <p class="mono hero__line">
        {site.principal}, {site.principalTitle} <span aria-hidden="true">·</span> {site.location}
      </p>
    </div>

    <div class="hero__now">
      {
        slides.map(({ p }, i) => (
          <a class:list={['label', i === 0 && 'is-on']} href={`/work/${p.id}/`} data-label={i} tabindex={i === 0 ? undefined : -1}>
            <span class="label__title">{p.data.title}</span>
            <span class="mono label__meta">
              {roleOf(p).firm} <span aria-hidden="true">·</span> {p.data.years}
            </span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="hero__nav mono" aria-label="Choose a project">
    <span class="hero__count">
      <b data-count>01</b>/{pad(slides.length)}
    </span>
    <span class="hero__dots">
      {
        slides.map(({ p }, i) => (
          <button type="button" class:list={['dot', i === 0 && 'is-on']} data-dot={i} aria-label={p.data.title}>
            <span class="dot__fill"></span>
          </button>
        ))
      }
    </span>
  </div>

  <p class="hero__scroll mono" aria-hidden="true"><span></span>Scroll</p>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const labels = [...hero.querySelectorAll<HTMLElement>('[data-label]')];
    const dots = [...hero.querySelectorAll<HTMLElement>('[data-dot]')];
    const count = hero.querySelector<HTMLElement>('[data-count]')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const HOLD = 5200;
    let current = 0;
    let timer = 0;

    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('is-on', i === current));
      labels.forEach((l, i) => {
        l.classList.toggle('is-on', i === current);
        if (i === current) l.removeAttribute('tabindex');
        else l.setAttribute('tabindex', '-1');
      });
      dots.forEach((d, i) => d.classList.toggle('is-on', i === current));
      count.textContent = String(current + 1).padStart(2, '0');
    };

    const play = () => {
      clearTimeout(timer);
      if (still || slides.length < 2) return;
      hero.classList.remove('is-paused');
      timer = window.setTimeout(() => {
        show(current + 1);
        play();
      }, HOLD);
    };
    const pause = () => {
      clearTimeout(timer);
      hero.classList.add('is-paused');
    };

    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        show(i);
        play();
      }),
    );
    // Hold while the pointer is over the captions, and stop when the hero scrolls away.
    hero.querySelector('.hero__foot')!.addEventListener('pointerenter', pause);
    hero.querySelector('.hero__foot')!.addEventListener('pointerleave', play);
    new IntersectionObserver(([e]) => (e.isIntersecting ? play() : pause()), { threshold: 0.2 }).observe(hero);
    play();
  }
</script>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
  }
  .hero__stage {
    position: absolute;
    inset: 0;
  }
  .slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 1.4s var(--ease);
  }
  .slide.is-on {
    opacity: 1;
  }
  .slide :global(picture),
  .slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
  }
  /* Slow drift on the visible frame */
  .slide.is-on :global(img) {
    animation: drift 9s linear both;
  }
  @keyframes drift {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.1);
    }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(5, 5, 5, 0.82) 0%, rgba(5, 5, 5, 0.1) 42%, rgba(5, 5, 5, 0) 62%),
      linear-gradient(to bottom, rgba(5, 5, 5, 0.55) 0%, rgba(5, 5, 5, 0) 24%);
  }

  .hero__foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(56px, 7vw, 92px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .hero__title {
    margin: 0 0 14px -0.04em;
    font-weight: 900;
    font-size: clamp(44px, 7.4vw, 140px);
    line-height: 0.86;
    letter-spacing: -0.06em;
  }
  .is-ready .hero__title .mask > span {
    transform: none;
    transition-delay: 0.25s;
  }
  .hero__line {
    margin: 0;
    color: rgba(243, 243, 240, 0.75);
  }

  /* The caption of the project on screen */
  .hero__now {
    position: relative;
    flex: 0 1 auto;
    min-width: min(42vw, 420px);
    min-height: 74px;
  }
  .label {
    position: absolute;
    right: 0;
    bottom: 0;
    display: block;
    text-align: right;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
    pointer-events: none;
  }
  .label.is-on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .label__title {
    display: block;
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 40px);
    letter-spacing: -0.035em;
    line-height: 1.05;
    background: linear-gradient(currentColor, currentColor) 100% 100% / 0 1px no-repeat;
    transition: background-size 0.5s var(--ease);
  }
  .label:hover .label__title {
    background-size: 100% 1px;
  }
  .label__meta {
    display: block;
    margin-top: 8px;
    color: rgba(243, 243, 240, 0.7);
  }

  /* Counter and dots */
  .hero__nav {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    translate: 0 -50%;
    display: grid;
    justify-items: end;
    gap: 14px;
    color: var(--white);
  }
  .hero__count b {
    font-weight: 500;
  }
  .hero__dots {
    display: grid;
    gap: 10px;
  }
  .dot {
    width: 34px;
    height: 14px;
    padding: 6px 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .dot__fill {
    display: block;
    height: 2px;
    background: rgba(243, 243, 240, 0.35);
    transform-origin: right;
  }
  .dot.is-on .dot__fill {
    background: var(--white);
    animation: dot-fill 5.2s linear both;
  }
  .is-paused .dot.is-on .dot__fill {
    animation-play-state: paused;
  }
  @keyframes dot-fill {
    from {
      transform: scaleX(0.25);
    }
    to {
      transform: scaleX(1);
    }
  }
  .dot:hover .dot__fill {
    background: var(--white);
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    translate: -50% 0;
    color: rgba(243, 243, 240, 0.7);
  }
  .hero__scroll span {
    width: 1px;
    height: 30px;
    background: linear-gradient(var(--white) 50%, transparent 50%) 0 0 / 1px 200%;
    animation: drip 1.6s var(--ease) infinite;
  }
  @keyframes drip {
    from {
      background-position: 0 100%;
    }
    to {
      background-position: 0 -100%;
    }
  }

  @media (max-width: 860px) {
    .hero__foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
      bottom: clamp(64px, 12vw, 96px);
    }
    .hero__now {
      min-width: 0;
      width: 100%;
      min-height: 62px;
    }
    .label {
      right: auto;
      left: 0;
      text-align: left;
    }
    .hero__nav {
      top: auto;
      bottom: 22px;
      right: var(--gutter);
      grid-auto-flow: column;
      align-items: center;
      gap: 10px;
    }
    .hero__dots {
      grid-auto-flow: column;
    }
    .dot {
      width: 18px;
    }
    .hero__scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide.is-on :global(img),
    .dot.is-on .dot__fill,
    .hero__scroll span {
      animation: none;
    }
  }
</style>
