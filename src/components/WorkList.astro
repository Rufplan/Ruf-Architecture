---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---

<ol class="wl" data-worklist>
  {
    projects.map((p, i) => (
      <li>
        <a
          href={`/work/${p.id}/`}
          class="wl__row wrap"
          data-cursor="View"
          data-form={p.data.form}
          data-seed={p.data.seed}
          data-title={p.data.title}
        >
          <span class="wl__idx mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="wl__title">{p.data.title}</span>
          <span class="wl__meta mono">
            <span>{p.data.typology}</span>
            <span>{p.data.status}</span>
            <span>{p.data.year}</span>
          </span>
          <canvas class="wl__thumb" aria-hidden="true" />
        </a>
      </li>
    ))
  }
</ol>

<div class="wl__preview" aria-hidden="true">
  <canvas></canvas>
  <span class="wl__preview-label mono"></span>
  <span class="wl__preview-corner mono">Axo / 1:500</span>
</div>

<script>
  import { SnapshotRenderer, reducedMotion, type Form, type Stage } from '../scripts/massing';

  const list = document.querySelector<HTMLElement>('[data-worklist]');
  const preview = document.querySelector<HTMLElement>('.wl__preview');
  if (list && preview) {
    const snap = new SnapshotRenderer();
    const rows = [...list.querySelectorAll<HTMLAnchorElement>('.wl__row')];
    const canvas = preview.querySelector('canvas')!;
    const label = preview.querySelector<HTMLElement>('.wl__preview-label')!;
    const light = { fg: 0x050505, bg: 0xf3f3f0 };
    const dark = { fg: 0xf3f3f0, bg: 0x050505 };
    const canHover = matchMedia('(hover: hover) and (pointer: fine)');

    // Touch devices: a static drawing under each row.
    const drawThumbs = () => {
      if (canHover.matches) return;
      for (const row of rows) {
        const stage = snap.stage(row.dataset.form as Form, Number(row.dataset.seed), dark, 'axo', 1.1);
        stage.explode = stage.explodeTarget = 0.25;
        snap.draw(row.querySelector('canvas')!, stage);
      }
    };
    drawThumbs();
    let resizeTimer = 0;
    addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(drawThumbs, 200);
    });

    // Desktop: floating live preview that follows the cursor.
    let active: Stage | null = null;
    let raf = 0;
    let last = 0;
    let x = 0, y = 0, px = 0, py = 0;

    const loop = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      px += (x - px) * 0.14;
      py += (y - py) * 0.14;
      preview.style.transform = `translate3d(${px}px, ${py}px, 0)`;
      if (active) snap.draw(canvas, active, dt);
      raf = requestAnimationFrame(loop);
    };

    const still = reducedMotion();
    for (const row of rows) {
      row.addEventListener('pointerenter', (e) => {
        if (!canHover.matches) return;
        active = snap.stage(row.dataset.form as Form, Number(row.dataset.seed), light, 'axo', 1.05);
        active.spinSpeed = still ? 0 : 0.6;
        active.explode = 0;
        active.explodeTarget = still ? 0 : 0.45;
        label.textContent = row.dataset.title ?? '';
        if (!preview.classList.contains('is-on')) {
          x = px = e.clientX;
          y = py = e.clientY;
        }
        preview.classList.add('is-on');
        if (!raf) {
          last = performance.now();
          raf = requestAnimationFrame(loop);
        }
      });
    }
    list.addEventListener('pointerleave', () => {
      preview.classList.remove('is-on');
      setTimeout(() => {
        if (!preview.classList.contains('is-on')) {
          cancelAnimationFrame(raf);
          raf = 0;
          active = null;
        }
      }, 600);
    });
    addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
    }, { passive: true });
  }
</script>

<style>
  .wl {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-dark);
  }
  .wl li {
    border-bottom: 1px solid var(--line-dark);
  }
  .wl__row {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    align-items: center;
    gap: 20px;
    padding-block: clamp(18px, 2.4vw, 34px);
    transition: opacity 0.5s var(--ease), background-color 0.5s var(--ease);
  }
  .wl__idx {
    color: var(--grey);
  }
  .wl__title {
    font-weight: 800;
    font-size: clamp(34px, 6.6vw, 118px);
    line-height: 0.9;
    letter-spacing: -0.055em;
    transition: transform 0.7s var(--ease), font-weight 0.7s;
  }
  .wl__meta {
    display: flex;
    gap: 28px;
    color: var(--grey);
  }
  .wl__thumb {
    display: none;
  }
  @media (hover: hover) {
    .wl:hover .wl__row {
      opacity: 0.25;
    }
    .wl:hover .wl__row:hover {
      opacity: 1;
    }
    .wl__row:hover .wl__title {
      transform: translateX(clamp(12px, 3vw, 48px));
      font-weight: 300;
    }
  }

  .wl__preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: clamp(260px, 24vw, 420px);
    aspect-ratio: 4 / 5;
    max-width: 100%;
    margin: calc(clamp(260px, 24vw, 420px) * -0.625) 0 0 calc(clamp(260px, 24vw, 420px) * -0.5);
    pointer-events: none;
    background: var(--white);
    color: var(--black);
    clip-path: inset(50% 50% 50% 50%);
    transition: clip-path 0.7s var(--ease);
  }
  .wl__preview.is-on {
    clip-path: inset(0 0 0 0);
  }
  .wl__preview canvas {
    width: 100%;
    height: 100%;
  }
  .wl__preview-label,
  .wl__preview-corner {
    position: absolute;
    left: 14px;
    bottom: 12px;
  }
  .wl__preview-corner {
    top: 12px;
    bottom: auto;
    opacity: 0.5;
  }

  @media (hover: none), (pointer: coarse) {
    .wl__preview {
      display: none;
    }
    .wl__row {
      grid-template-columns: 40px 1fr;
    }
    .wl__meta {
      grid-column: 2;
      flex-wrap: wrap;
      gap: 6px 18px;
    }
    .wl__thumb {
      display: block;
      grid-column: 1 / -1;
      width: 100%;
      aspect-ratio: 16 / 10;
      border: 1px solid var(--line-dark);
    }
  }
  @media (max-width: 760px) {
    .wl__row {
      grid-template-columns: 40px 1fr;
    }
    .wl__meta {
      grid-column: 2;
      flex-wrap: wrap;
      gap: 6px 18px;
    }
  }
</style>
