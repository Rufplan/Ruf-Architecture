---
import { roleOf, coverThumb, type Project } from '../lib/projects';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
const thumbs = await Promise.all(projects.map((p) => coverThumb(p, 900)));
---

<ol class="wl" data-worklist>
  {
    projects.map((p, i) => (
      <li>
        <a
          href={`/work/${p.id}/`}
          class="wl__row wrap"
          data-cursor="View"
          data-title={p.data.title}
          data-image={thumbs[i]}
        >
          <span class="wl__idx mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="wl__title">{p.data.title}</span>
          <span class="wl__meta mono">
            <span>{p.data.typology}</span>
            <span>{roleOf(p).firm}</span>
            <span>{p.data.years}</span>
          </span>
          {thumbs[i] && (
            <span class="wl__thumb tone" aria-hidden="true">
              <img src={thumbs[i]} alt="" loading="lazy" decoding="async" />
            </span>
          )}
        </a>
      </li>
    ))
  }
</ol>

<div class="wl__preview" aria-hidden="true">
  <img class="wl__preview-img" alt="" />
  <span class="wl__preview-label mono"></span>
</div>

<script>
  // Desktop: a floating photo preview that follows the cursor (projects with photography only).
  const list = document.querySelector<HTMLElement>('[data-worklist]');
  const preview = document.querySelector<HTMLElement>('.wl__preview');
  if (list && preview) {
    const rows = [...list.querySelectorAll<HTMLAnchorElement>('.wl__row')];
    const label = preview.querySelector<HTMLElement>('.wl__preview-label')!;
    const photo = preview.querySelector<HTMLImageElement>('.wl__preview-img')!;
    const canHover = matchMedia('(hover: hover) and (pointer: fine)');
    let raf = 0;
    let x = 0, y = 0, px = 0, py = 0;

    const loop = () => {
      px += (x - px) * 0.14;
      py += (y - py) * 0.14;
      preview.style.transform = `translate3d(${px}px, ${py}px, 0)`;
      raf = requestAnimationFrame(loop);
    };

    for (const row of rows) {
      row.addEventListener('pointerenter', (e) => {
        const image = row.dataset.image;
        if (!canHover.matches || !image) {
          preview.classList.remove('is-on');
          return;
        }
        photo.src = image;
        label.textContent = row.dataset.title ?? '';
        if (!preview.classList.contains('is-on')) {
          x = px = e.clientX;
          y = py = e.clientY;
        }
        preview.classList.add('is-on');
        if (!raf) raf = requestAnimationFrame(loop);
      });
    }
    list.addEventListener('pointerleave', () => {
      preview.classList.remove('is-on');
      setTimeout(() => {
        if (!preview.classList.contains('is-on')) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      }, 600);
    });
    addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
    }, { passive: true });
  }
</script>

<style>
  .wl {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-dark);
  }
  .wl li {
    border-bottom: 1px solid var(--line-dark);
  }
  .wl__row {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    align-items: center;
    gap: 20px;
    padding-block: clamp(18px, 2.4vw, 34px);
    transition: opacity 0.5s var(--ease), background-color 0.5s var(--ease);
  }
  .wl__idx {
    color: var(--grey);
  }
  .wl__title {
    font-weight: 800;
    font-size: clamp(34px, 6.6vw, 118px);
    line-height: 0.9;
    letter-spacing: -0.055em;
    transition: transform 0.7s var(--ease), font-weight 0.7s;
  }
  .wl__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    text-align: right;
    color: var(--grey);
  }
  .wl__thumb {
    display: none;
  }
  @media (hover: hover) {
    .wl:hover .wl__row {
      opacity: 0.25;
    }
    .wl:hover .wl__row:hover {
      opacity: 1;
    }
    .wl__row:hover .wl__title {
      transform: translateX(clamp(12px, 3vw, 48px));
      font-weight: 300;
    }
  }

  .wl__preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: clamp(320px, 34vw, 620px);
    aspect-ratio: 4 / 3;
    max-width: 100%;
    margin: calc(clamp(320px, 34vw, 620px) * -0.375) 0 0 calc(clamp(320px, 34vw, 620px) * -0.5);
    pointer-events: none;
    background: var(--black);
    color: var(--white);
    clip-path: inset(50% 50% 50% 50%);
    transition: clip-path 0.7s var(--ease);
  }
  .wl__preview.is-on {
    clip-path: inset(0 0 0 0);
  }
  .wl__preview-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: preview-zoom 1.4s var(--ease) both;
  }
  @keyframes preview-zoom {
    from {
      transform: scale(1.15);
    }
  }
  .wl__preview-label {
    position: absolute;
    left: 14px;
    bottom: 12px;
    mix-blend-mode: difference;
  }

  @media (hover: none), (pointer: coarse) {
    .wl__preview {
      display: none;
    }
    .wl__row {
      grid-template-columns: 40px 1fr;
    }
    .wl__meta {
      grid-column: 2;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 6px 18px;
      text-align: left;
    }
    .wl__thumb {
      display: block;
      grid-column: 1 / -1;
      width: 100%;
      aspect-ratio: 16 / 10;
      border: 1px solid var(--line-dark);
      overflow: hidden;
    }
    .wl__thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
  @media (max-width: 760px) {
    .wl__row {
      grid-template-columns: 40px 1fr;
    }
    .wl__meta {
      grid-column: 2;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 6px 18px;
      text-align: left;
    }
  }
</style>
