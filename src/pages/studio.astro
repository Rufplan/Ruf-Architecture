---
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import { site } from '../site.config';
import { Picture } from 'astro:assets';
import { portrait } from '../lib/images';
import { getProjects } from '../lib/projects';
import { experience, expertise, software, languages } from '../data/experience';

const portraitImg = portrait();
const projects = await getProjects();
const projectsByFirm = (key: string) => projects.filter((p) => p.data.experience === key);
const details = [
  ['Based in', site.location],
  ['Licensed in', site.licensed],
  ['Experience', '10+ years'],
  ['Projects', String(projects.length)],
  ['Languages', languages.join(', ')],
];
---

<Base title="Studio" description={site.bio[0]}>
  <section class="s-hero dark">
    <div class="wrap s-hero__inner">
      <p class="mono s-hero__kicker">( Studio )</p>
      <h1 class="s-hero__title">
        <span class="mask"><span>Less,</span></span>
        <span class="mask"><span><em>but</em> heavier.</span></span>
      </h1>
    </div>
  </section>

  <section class="s-principal light">
    <div class="wrap s-principal__grid">
      <div class="s-principal__portrait" data-reveal>
        <div class="s-principal__frame">
          {
            portraitImg ? (
              <Picture src={portraitImg} alt={`${site.principal}, ${site.principalTitle}`} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 40vw" class="portrait" />
            ) : (
              <span class="mono">Portrait — {site.principal}</span>
            )
          }
        </div>
      </div>
      <div class="s-principal__body">
        <p class="mono">( {site.principalTitle} )</p>
        <h2 class="s-principal__name">
          <span class="mask"><span>{site.principal}</span></span>
        </h2>
        <div class="s-principal__bio" data-reveal>
          {site.bio.map((para) => <p>{para}</p>)}
        </div>
        <dl class="s-details mono" data-reveal>
          {
            details.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <Marquee words={['Revit', 'Schematic Design', 'Permit Drawings', 'Massing', 'Rendering']} />

  <section class="s-exp dark">
    <div class="wrap">
      <p class="mono s-kicker">( Experience )</p>
      <ol class="s-exp__list">
        {
          experience.map((e) => (
            <li class="s-exp__item" data-reveal>
              <p class="mono s-exp__dates">{e.dates}</p>
              <div>
                <h3 class="s-exp__firm">{e.firm}</h3>
                <p class="mono s-exp__role">
                  {e.role} · {e.location}
                </p>
              </div>
              <ul class="s-exp__projects">
                {projectsByFirm(e.key).map((p) => (
                  <li>
                    <a href={`/work/${p.id}/`} class="link" data-cursor="View">
                      {p.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="s-skills light">
    <div class="wrap s-skills__grid">
      <div>
        <p class="mono s-kicker">( Expertise )</p>
        <ol class="s-skills__expertise">
          {
            expertise.map((x, i) => (
              <li data-reveal>
                <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                {x}
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <p class="mono s-kicker">( Software )</p>
        <ul class="s-skills__software mono">
          {
            software.map((x) => (
              <li data-reveal>
                <span>{x.name}</span>
                <span class="s-skills__level">{x.level}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>


<style>
  .s-hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
  }
  .s-hero__scene {
    position: absolute;
    inset: 0 0 0 30%;
  }
  .s-hero__inner {
    position: absolute;
    inset: auto 0 0 0;
    padding-bottom: clamp(20px, 3vw, 44px);
    pointer-events: none;
  }
  .s-hero__kicker {
    color: var(--grey);
    margin: 0 0 20px;
  }
  .s-hero__title {
    margin: 0 0 0 -0.04em;
    font-weight: 900;
    font-size: clamp(64px, 15vw, 280px);
    line-height: 0.82;
    letter-spacing: -0.07em;
    mix-blend-mode: difference;
  }
  .s-hero__title em {
    font-style: normal;
    font-weight: 300;
  }
  .is-ready .s-hero__title .mask > span {
    transform: none;
    transition-delay: 0.3s;
  }
  .is-ready .s-hero__title .mask:nth-child(2) > span {
    transition-delay: 0.42s;
  }

  .s-principal {
    padding-block: clamp(100px, 14vw, 200px);
  }
  .s-principal__grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
  }
  .s-principal__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    background: var(--black);
    color: var(--grey);
    display: grid;
    place-items: end start;
    padding: 18px;
    background-image:
      linear-gradient(var(--line-dark), var(--line-dark)),
      linear-gradient(var(--line-dark), var(--line-dark));
    background-size: 1px 100%, 100% 1px;
    background-position: center;
    background-repeat: no-repeat;
  }
  .s-principal__name {
    margin: 20px 0 0;
    font-weight: 900;
    font-size: clamp(56px, 9vw, 170px);
    line-height: 0.84;
    letter-spacing: -0.065em;
  }
  .s-principal__bio {
    margin-top: 48px;
    max-width: 36em;
    font-size: clamp(17px, 1.4vw, 22px);
    line-height: 1.5;
  }

  .s-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 20px 24px;
    margin: 48px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line-light);
  }
  .s-details dt {
    color: #6b6b67;
  }
  .s-details dd {
    margin: 4px 0 0;
  }
  .s-kicker {
    color: var(--grey);
    margin: 0 0 40px;
  }

  /* EXPERIENCE */
  .s-exp {
    padding-block: clamp(100px, 14vw, 200px);
  }
  .s-exp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-dark);
  }
  .s-exp__item {
    display: grid;
    grid-template-columns: minmax(150px, 1fr) 2.2fr 1.6fr;
    gap: 16px clamp(16px, 3vw, 48px);
    padding-block: clamp(22px, 3vw, 40px);
    border-bottom: 1px solid var(--line-dark);
  }
  .s-exp__dates {
    margin: 0;
    padding-top: 0.6em;
    color: var(--grey);
  }
  .s-exp__firm {
    margin: 0;
    font-weight: 800;
    font-size: clamp(30px, 3.8vw, 64px);
    line-height: 0.92;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .s-exp__role {
    margin: 12px 0 0;
    color: var(--grey);
  }
  .s-exp__projects {
    list-style: none;
    margin: 0;
    padding: 0.5em 0 0;
    display: grid;
    gap: 6px;
    align-content: start;
    font-size: clamp(15px, 1.2vw, 18px);
  }

  /* SKILLS */
  .s-skills {
    padding-block: clamp(100px, 14vw, 200px);
  }
  .s-skills__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(40px, 6vw, 120px);
  }
  .s-skills__expertise,
  .s-skills__software {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-light);
  }
  .s-skills__expertise li {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line-light);
    font-weight: 800;
    font-size: clamp(30px, 4vw, 68px);
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .s-skills__expertise .mono {
    font-weight: 400;
    color: #6b6b67;
  }
  .s-skills__software li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line-light);
    font-size: 13px;
  }
  .s-skills__level {
    color: #6b6b67;
  }

  @media (max-width: 860px) {
    .s-hero__scene {
      inset: 0;
    }
    .s-principal__grid,
    .s-skills__grid {
      grid-template-columns: 1fr;
    }
    .s-exp__item {
      grid-template-columns: 1fr;
    }
    .s-exp__dates {
      padding-top: 0;
    }
  }</style>
