---
import { render } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BuildSequence from '../../components/BuildSequence.astro';
import type { Media } from '../../lib/images';
import { getProjects, roleOf, mediaOf, coverOf, coverThumb } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, index, next } = Astro.props;
const { Content } = await render(project);
const hasBody = project.body?.trim().length > 0;
const d = project.data;
const role = roleOf(project);
const summary = d.summary ?? `${role.role} at ${role.firm}.`;
const num = String(index + 1).padStart(2, '0');

const media = mediaOf(project);
const cover = coverOf(project);
const nextCover = await coverThumb(next, 2000);

// Lay the remaining media out editorially: full-bleed, wide, justified pairs, and offset singles.
// Sizes respect each file's resolution so small images are never blown up.
type Row = { type: 'bleed' | 'wide' | 'pair' | 'single'; items: Media[] };
const rest = media.filter((m) => m.file !== cover?.file);
const rows: Row[] = [];
{
  const isImage = (m?: Media): m is Extract<Media, { kind: 'image' }> => !!m && m.kind === 'image';
  const canBleed = (m: Media) => isImage(m) && m.src.width >= 1600;
  const canWide = (m: Media) => isImage(m) && m.src.width >= 1100;
  let beat = 0;
  for (let i = 0; i < rest.length; ) {
    const m = rest[i];
    const n = rest[i + 1];
    if (m.kind === 'video') {
      rows.push({ type: 'bleed', items: [m] });
      i++;
    } else if (m.ratio < 1.25 || !canWide(m)) {
      // Upright or low-resolution: pair with the next still, or sit alone at half width.
      if (isImage(n)) {
        rows.push({ type: 'pair', items: [m, n] });
        i += 2;
      } else {
        rows.push({ type: 'single', items: [m] });
        i++;
      }
    } else {
      const b = beat++ % 3;
      if (b === 0) {
        rows.push({ type: canBleed(m) ? 'bleed' : 'wide', items: [m] });
        i++;
      } else if (b === 1 && isImage(n) && n.ratio >= 1.25) {
        rows.push({ type: 'pair', items: [m, n] });
        i += 2;
      } else {
        rows.push({ type: 'wide', items: [m] });
        i++;
      }
    }
  }
}

// Full-size sources for the lightbox, in page order.
const stills = rest.filter((m): m is Extract<Media, { kind: 'image' }> => m.kind === 'image');
const lightbox = await Promise.all(
  stills.map(async (m) => ({
    src: (await getImage({ src: m.src, width: Math.min(2400, m.src.width), format: 'webp' })).src,
    caption: m.caption ?? '',
  })),
);
const lightboxIndex = (m: Media) => stills.indexOf(m as (typeof stills)[number]);
const altFor = (m: Media) => (m.caption ? `${d.title} — ${m.caption}` : `${d.title}, image ${media.findIndex((x) => x.file === m.file) + 1}`);

const facts = [
  ['Firm', role.firm],
  ['Role', role.role],
  ['Location', d.location],
  ['Years', d.years],
  ['Type', d.typology],
  ...(d.status ? [['Status', d.status]] : []),
  ...(d.area ? [['Area', d.area]] : []),
];
---

<Base title={d.title} description={`${d.title}, ${d.location} — ${role.role} at ${role.firm}.`}>
  {
    cover ? (
      <BuildSequence
        cover={cover}
        alt={altFor(cover)}
        heading={d.title}
        kicker={`No. ${num} / ${d.typology}`}
        tagLeft={`Work / ${num}`}
        tagRight={`${media.length} ${media.length === 1 ? 'image' : 'images'}`}
      />
    ) : (
      <section class="p-hero p-hero--plain dark">
        <div class="p-hero__crumb wrap mono">
          <a href="/work/" class="link">Work</a>
          <span>/</span>
          <span>{num}</span>
        </div>
        <p class="p-hero__count wrap mono">Photography to come</p>
        <div class="p-hero__foot wrap">
          <h1 class:list={['p-hero__title', d.title.length > 20 && 'is-long']}>
            <span class="mask"><span>{d.title}</span></span>
          </h1>
          <dl class="p-hero__facts mono">
            {facts.slice(0, 4).map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  <!-- TEXT -->
  <section class="p-text light">
    <div class="wrap p-text__grid">
      <p class="mono p-text__kicker">( {num} — Project )</p>
      <p class="p-text__summary" data-reveal>{summary}</p>
      <div class="p-text__body" data-reveal>
        {hasBody && <Content />}
        {
          role.description && (
            <>
              <p class="mono p-text__label">( The role — {role.firm}, {role.dates} )</p>
              <p>{role.description}</p>
            </>
          )
        }
      </div>
      <dl class="p-text__facts mono" data-reveal>
        {
          facts.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- GALLERY -->
  {
    rows.length > 0 && (
      <section class="p-gallery dark" aria-label="Images">
        {rows.map((row) => (
          <div class:list={['row', `row--${row.type}`, row.type !== 'bleed' && 'wrap']}>
            {row.items.map((m) => (
              <figure
                class="shot tone"
                style={row.type === 'pair' ? `flex-grow: ${m.ratio.toFixed(3)}` : undefined}
                data-reveal
              >
                {m.kind === 'video' ? (
                  <video src={m.src} muted loop playsinline preload="metadata" data-autoplay aria-label={altFor(m)} />
                ) : (
                  <button type="button" class="shot__open" data-open={lightboxIndex(m)} aria-label={`Enlarge: ${altFor(m)}`}>
                    <Picture
                      src={m.src}
                      alt={altFor(m)}
                      formats={['avif', 'webp']}
                      widths={[640, 1024, 1600, 2400].filter((w) => w <= m.src.width).concat(m.src.width < 640 ? [m.src.width] : [])}
                      sizes={row.type === 'bleed' ? '100vw' : row.type === 'pair' ? '(max-width: 760px) 100vw, 50vw' : row.type === 'single' ? '(max-width: 760px) 100vw, 50vw' : '100vw'}
                    />
                  </button>
                )}
                {m.caption && <figcaption class="mono">{m.caption}</figcaption>}
              </figure>
            ))}
          </div>
        ))}
      </section>
    )
  }

  <!-- NEXT -->
  <a href={`/work/${next.id}/`} class:list={['p-next dark', nextCover && 'p-next--image']}>
    {nextCover && <img class="p-next__bg" src={nextCover} alt="" loading="lazy" decoding="async" />}
    <span class="wrap p-next__label mono">Next project →</span>
    <span class="wrap p-next__title">{next.data.title}</span>
  </a>

  {
    lightbox.length > 0 && (
      <dialog class="lb" aria-label="Image viewer" data-images={JSON.stringify(lightbox)}>
        <img class="lb__img" alt="" />
        <div class="lb__bar wrap mono">
          <span class="lb__count" />
          <span class="lb__caption" />
          <span class="lb__nav">
            <button type="button" data-prev aria-label="Previous image">← Prev</button>
            <button type="button" data-next aria-label="Next image">Next →</button>
            <button type="button" data-close aria-label="Close">Close ×</button>
          </span>
        </div>
      </dialog>
    )
  }
</Base>

<script>
  const reducedMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Videos play only while on screen
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
  const vio = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting && !reducedMotion()) v.play().catch(() => {});
      else v.pause();
    }
  }, { threshold: 0.25 });
  videos.forEach((v) => vio.observe(v));

  // Lightbox
  const lb = document.querySelector<HTMLDialogElement>('.lb');
  if (lb) {
    const images: { src: string; caption: string }[] = JSON.parse(lb.dataset.images!);
    const img = lb.querySelector<HTMLImageElement>('.lb__img')!;
    const count = lb.querySelector<HTMLElement>('.lb__count')!;
    const caption = lb.querySelector<HTMLElement>('.lb__caption')!;
    let current = 0;
    const show = (i: number) => {
      current = (i + images.length) % images.length;
      img.src = images[current].src;
      count.textContent = `${String(current + 1).padStart(2, '0')} / ${String(images.length).padStart(2, '0')}`;
      caption.textContent = images[current].caption;
    };
    document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) =>
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.open));
        lb.showModal();
      }),
    );
    lb.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
    lb.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));
    lb.querySelector('[data-close]')!.addEventListener('click', () => lb.close());
    img.addEventListener('click', () => show(current + 1));
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });
    let startX: number | null = null;
    lb.addEventListener('pointerdown', (e) => (startX = e.clientX));
    lb.addEventListener('pointerup', (e) => {
      if (startX !== null && Math.abs(e.clientX - startX) > 50) show(current + (e.clientX < startX ? 1 : -1));
      startX = null;
    });
  }
</script>

<style>
  /* HERO */
  .p-hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
  }
  .p-hero--plain {
    height: 78vh;
    min-height: 520px;
  }
  .p-hero__scene {
    position: absolute;
    inset: 0;
    touch-action: pan-y;
  }
  .p-hero__media {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .p-hero__media :global(picture),
  .p-hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .p-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(5, 5, 5, 0.92) 0%, rgba(5, 5, 5, 0.55) 30%, rgba(5, 5, 5, 0) 58%),
      linear-gradient(to bottom, rgba(5, 5, 5, 0.55) 0%, rgba(5, 5, 5, 0) 22%);
  }
  .p-hero__crumb {
    position: absolute;
    top: 76px;
    left: 0;
    display: flex;
    gap: 10px;
    color: var(--grey);
  }
  .p-hero--image .p-hero__crumb {
    color: var(--white);
  }
  .p-hero__note {
    opacity: 0.6;
  }
  .p-hero__count {
    position: absolute;
    top: 76px;
    right: 0;
    margin: 0;
  }
  .p-hero__controls {
    position: absolute;
    top: 76px;
    right: 0;
    display: flex;
    gap: 16px;
  }
  .p-hero__controls button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--grey);
    background: none;
    border: 0;
    padding: 0;
    transition: color 0.3s;
  }
  .p-hero__controls button[aria-pressed='true'],
  .p-hero__controls button:hover {
    color: var(--white);
  }
  .p-hero__foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding-bottom: clamp(16px, 2.5vw, 36px);
    pointer-events: none;
  }
  .p-hero__title {
    margin: 0 0 clamp(18px, 2vw, 28px) -0.04em;
    font-weight: 900;
    font-size: clamp(56px, 12.5vw, 240px);
    line-height: 0.84;
    letter-spacing: -0.07em;
  }
  .p-hero__title--blend {
    mix-blend-mode: difference;
  }
  .p-hero__title.is-long {
    font-size: clamp(44px, 8.4vw, 170px);
  }
  .is-ready .p-hero__title .mask > span {
    transform: none;
    transition-delay: 0.3s;
  }
  .p-hero__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--line-dark);
  }
  .p-hero--image .p-hero__facts {
    border-top-color: rgba(243, 243, 240, 0.4);
  }
  .p-hero__facts dt,
  .p-text__facts dt {
    color: var(--grey);
  }
  .p-hero--image .p-hero__facts dt {
    color: rgba(243, 243, 240, 0.65);
  }
  .p-hero__facts dd,
  .p-text__facts dd {
    margin: 0;
  }

  /* TEXT */
  .p-text {
    padding-block: clamp(90px, 12vw, 180px);
  }
  .p-text__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 40px clamp(16px, 2vw, 32px);
  }
  .p-text__kicker {
    grid-column: 1 / -1;
    margin: 0;
  }
  .p-text__summary {
    grid-column: 1 / 10;
    margin: 0;
    font-weight: 500;
    font-size: clamp(30px, 4.6vw, 76px);
    line-height: 1;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .p-text__body {
    grid-column: 6 / 12;
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.5;
  }
  .p-text__body :global(p) {
    margin: 0 0 1.1em;
  }
  .p-text__label {
    margin: 0 0 12px !important;
    font-size: 11px;
    color: #6b6b67;
  }
  .p-text__facts {
    grid-column: 1 / 5;
    grid-row: 3;
    margin: 0;
    align-self: start;
    border-top: 1px solid var(--line-light);
  }
  .p-text__facts div {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 12px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line-light);
  }
  .p-text__facts dt {
    color: #6b6b67;
  }

  /* GALLERY */
  .p-gallery {
    display: grid;
    gap: clamp(16px, 2.4vw, 40px);
    padding-block: clamp(16px, 2.4vw, 40px) clamp(90px, 12vw, 180px);
  }
  .row {
    display: flex;
    gap: clamp(16px, 2.4vw, 40px);
  }
  .shot {
    position: relative;
    margin: 0;
    min-width: 0;
    flex: 1 1 0;
    overflow: hidden;
  }
  .shot__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    overflow: hidden;
  }
  .shot :global(img),
  .shot video {
    display: block;
    width: 100%;
    height: auto;
    transform: scale(1.06);
  }
  .shot.is-color :global(img),
  .shot.is-color video {
    transform: none;
  }
  .row--bleed .shot :global(img),
  .row--bleed .shot video {
    max-height: 115vh;
    object-fit: cover;
  }
  .row--single {
    justify-content: flex-end;
  }
  .row--single:nth-of-type(even) {
    justify-content: flex-start;
  }
  .row--single .shot {
    flex: 0 1 46%;
  }
  .shot figcaption {
    padding-top: 12px;
    color: var(--grey);
  }
  .row--bleed .shot figcaption {
    padding-inline: var(--gutter);
  }

  /* NEXT */
  .p-next {
    position: relative;
    display: block;
    padding-block: clamp(70px, 10vw, 150px);
    border-top: 1px solid var(--line-dark);
    overflow: hidden;
  }
  .p-next--image {
    padding-block: clamp(140px, 22vw, 360px) clamp(40px, 5vw, 80px);
  }
  .p-next__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.45);
    transform: scale(1.05);
    transition: filter 1.2s var(--ease), transform 1.6s var(--ease);
  }
  .p-next:hover .p-next__bg {
    filter: grayscale(0) brightness(0.6);
    transform: none;
  }
  .p-next__label,
  .p-next__title {
    position: relative;
  }
  .p-next__label {
    display: block;
    color: var(--grey);
    margin-bottom: 20px;
  }
  .p-next--image .p-next__label {
    color: var(--white);
  }
  .p-next__title {
    display: block;
    font-weight: 900;
    font-size: clamp(52px, 11vw, 200px);
    line-height: 0.86;
    letter-spacing: -0.07em;
    transition: transform 0.8s var(--ease), font-weight 0.8s;
  }
  .p-next:hover .p-next__title {
    transform: translateX(clamp(16px, 4vw, 70px));
    font-weight: 300;
  }

  /* LIGHTBOX */
  .lb {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--black);
    color: var(--white);
  }
  /* The custom cursor can't render above the top-layer dialog */
  .lb,
  .lb * {
    cursor: default !important;
  }
  .lb button {
    cursor: pointer !important;
  }
  .lb::backdrop {
    background: var(--black);
  }
  .lb[open] {
    display: grid;
    grid-template-rows: 1fr auto;
    animation: lb-in 0.5s var(--ease);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb__img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    padding: clamp(12px, 3vw, 48px) clamp(12px, 3vw, 48px) 0;
  }
  .lb__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 18px;
  }
  .lb__caption {
    flex: 1;
    color: var(--grey);
  }
  .lb__nav {
    display: flex;
    gap: 20px;
  }
  .lb__nav button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--white);
    background: none;
    border: 0;
    padding: 6px 0;
  }
  .lb__nav button:hover {
    opacity: 0.6;
  }

  @media (max-width: 860px) {
    .p-hero__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .p-text__summary,
    .p-text__body,
    .p-text__facts {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
  @media (max-width: 760px) {
    .row {
      flex-direction: column;
    }
    .row--single .shot {
      flex-basis: auto;
    }
    .lb__caption {
      display: none;
    }
  }
</style>
