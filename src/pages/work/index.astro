---
import Base from '../../layouts/Base.astro';
import { Picture } from 'astro:assets';
import { getProjects, roleOf, coverOf, mediaOf } from '../../lib/projects';

const projects = await getProjects();
const covers = projects.map((p) => coverOf(p));
const mediaCounts = projects.map((p) => mediaOf(p).length);
// Filter chips, most common typology first.
const counts = new Map<string, number>();
for (const p of projects) counts.set(p.data.typology, (counts.get(p.data.typology) ?? 0) + 1);
const typologies = [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([t]) => t);
---

<Base title="Work" description="Projects by Rufus Kerr across commercial, residential, civic and park work.">
  <section class="index dark">
    <div class="wrap index__head">
      <p class="mono">( Index — {String(projects.length).padStart(2, '0')} projects )</p>
      <h1 class="index__title">
        <span class="mask"><span>Work</span></span>
      </h1>
    </div>

    <div class="wrap index__filters mono" role="group" aria-label="Filter by type">
      <button type="button" data-filter="all" aria-pressed="true">All <sup>{projects.length}</sup></button>
      {
        typologies.map((t) => (
          <button type="button" data-filter={t} aria-pressed="false">
            {t} <sup>{counts.get(t)}</sup>
          </button>
        ))
      }
    </div>

    <div class="wrap index__grid">
      {
        projects.map((p, i) => (
          <a
            href={`/work/${p.id}/`}
            class="card"
            data-reveal
            data-cursor="Open"
            data-form={p.data.form}
            data-seed={p.data.seed}
            data-typology={p.data.typology}
          >
            <div class:list={['card__media', covers[i] && 'card__media--photo tone']}>
              {covers[i] ? (
                <Picture
                  src={covers[i]!.src}
                  alt=""
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1200].filter((w) => w <= covers[i]!.src.width).concat(covers[i]!.src.width < 480 ? [covers[i]!.src.width] : [])}
                  sizes="(max-width: 760px) 100vw, 50vw"
                />
              ) : (
                <canvas aria-hidden="true" />
              )}
              <span class="card__num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="card__form mono">{covers[i] ? `${mediaCounts[i]} ${mediaCounts[i] === 1 ? 'image' : 'images'}` : p.data.typology}</span>
            </div>
            <div class="card__info">
              <h2 class="card__title">{p.data.title}</h2>
              <p class="card__meta mono">
                <span>{roleOf(p).firm}</span>
                <span>{p.data.location}</span>
                <span>{p.data.years}</span>
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<script>
  import { SnapshotRenderer, reducedMotion, type Form, type Stage } from '../../scripts/massing';

  const cards = [...document.querySelectorAll<HTMLElement>('.card')].filter((c) => c.querySelector('canvas'));
  const allCards = [...document.querySelectorAll<HTMLElement>('.card')];
  const snap = new SnapshotRenderer();
  const palette = { fg: 0xf3f3f0, bg: 0x050505 };
  const still = reducedMotion();

  const stageFor = (card: HTMLElement) =>
    snap.stage(card.dataset.form as Form, Number(card.dataset.seed), palette, 'axo', 1.15);

  const drawAll = () => {
    for (const card of cards) {
      const stage = stageFor(card);
      stage.explode = stage.explodeTarget = 0;
      snap.draw(card.querySelector('canvas')!, stage);
    }
  };
  // Wait a frame so layout (and canvas client size) is settled.
  requestAnimationFrame(drawAll);
  let t = 0;
  addEventListener('resize', () => {
    clearTimeout(t);
    t = window.setTimeout(drawAll, 200);
  });

  // Typology filter
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      for (const card of allCards) {
        card.hidden = f !== 'all' && card.dataset.typology !== f;
        card.classList.add('is-in');
      }
      drawAll();
    });
  }

  let active: { card: HTMLElement; stage: Stage } | null = null;
  let raf = 0;
  let last = 0;
  const loop = (now: number) => {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    if (!active) return;
    snap.draw(active.card.querySelector('canvas')!, active.stage, dt);
    const settled = Math.abs(active.stage.explode - active.stage.explodeTarget) < 0.002 && active.stage.explodeTarget === 0;
    if (settled && !active.card.matches(':hover')) {
      active = null;
      raf = 0;
      return;
    }
    raf = requestAnimationFrame(loop);
  };

  if (!still) {
    for (const card of cards) {
      card.addEventListener('pointerenter', () => {
        if (active && active.card !== card) active.stage.explodeTarget = 0;
        const stage = stageFor(card);
        stage.spinSpeed = 0.5;
        stage.explodeTarget = 0.5;
        active = { card, stage };
        if (!raf) {
          last = performance.now();
          raf = requestAnimationFrame(loop);
        }
      });
      card.addEventListener('pointerleave', () => {
        const stage = stageFor(card);
        stage.explodeTarget = 0;
        stage.spinSpeed = 0;
      });
    }
  }
</script>

<style>
  .index {
    padding-top: clamp(120px, 16vw, 220px);
    padding-bottom: clamp(80px, 10vw, 160px);
  }
  .index__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: clamp(40px, 6vw, 100px);
  }
  .index__title {
    margin: 0;
    font-weight: 900;
    font-size: clamp(96px, 24vw, 440px);
    line-height: 0.76;
    letter-spacing: -0.075em;
  }
  .is-ready .index__title .mask > span {
    transform: none;
  }
  .index__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: clamp(32px, 4vw, 60px);
  }
  .index__filters button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--grey);
    background: none;
    border: 1px solid var(--line-dark);
    padding: 9px 14px;
    transition: color 0.3s, background-color 0.3s, border-color 0.3s;
  }
  .index__filters button:hover {
    color: var(--white);
    border-color: var(--white);
  }
  .index__filters button[aria-pressed='true'] {
    color: var(--black);
    background: var(--white);
    border-color: var(--white);
  }
  .index__filters sup {
    font-size: 0.8em;
    opacity: 0.6;
  }
  .index__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 80px) clamp(16px, 2.4vw, 40px);
  }
  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    max-width: 100%;
    border: 1px solid var(--line-dark);
    overflow: hidden;
    transition: background-color 0.6s var(--ease);
  }
  .card__media canvas,
  .card__media :global(picture),
  .card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__media--photo :global(img) {
    transform: scale(1.04);
  }
  .card:hover .card__media--photo :global(img) {
    filter: none;
    transform: none;
  }
  .card__media--photo .card__num,
  .card__media--photo .card__form {
    z-index: 1;
    color: var(--white);
    mix-blend-mode: difference;
  }
  .card__num,
  .card__form {
    position: absolute;
    top: 14px;
    color: var(--grey);
  }
  .card__num {
    left: 14px;
  }
  .card__form {
    right: 14px;
  }
  .card__info {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding-top: 18px;
  }
  .card__title {
    margin: 0;
    font-weight: 800;
    font-size: clamp(28px, 3.4vw, 56px);
    letter-spacing: -0.05em;
    line-height: 0.95;
    text-wrap: balance;
  }
  .card__meta {
    display: flex;
    gap: 18px;
    margin: 0;
    color: var(--grey);
  }
  .card:hover .card__media {
    border-color: var(--white);
  }
  @media (max-width: 760px) {
    .index__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
