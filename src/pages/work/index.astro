---
import Base from '../../layouts/Base.astro';
import { Picture } from 'astro:assets';
import { getProjects, roleOf, coverOf, mediaOf } from '../../lib/projects';

const projects = await getProjects();
const covers = projects.map((p) => coverOf(p));
const mediaCounts = projects.map((p) => mediaOf(p).length);
const years = projects.map((p) => p.data.year);
// Filter chips, most common typology first.
const counts = new Map<string, number>();
for (const p of projects) counts.set(p.data.typology, (counts.get(p.data.typology) ?? 0) + 1);
const typologies = [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([t]) => t);
---

<Base title="Work" description="Index of projects by Rufus Kerr across commercial, residential, civic and park work.">
  <section class="index light">
    <div class="wrap index__head">
      <h1 class="index__title">
        <span class="mask"><span>Index of <span class="serif">work</span></span></span>
      </h1>
      <p class="mono index__meta">
        {projects.length} projects · {Math.min(...years)}–{Math.max(...years)} · {projects.filter((_, i) => covers[i]).length} with photography
      </p>
    </div>

    <div class="wrap index__filters mono" role="group" aria-label="Filter by type">
      <button type="button" data-filter="all" aria-pressed="true">All <sup>{projects.length}</sup></button>
      {
        typologies.map((t) => (
          <button type="button" data-filter={t} aria-pressed="false">
            {t} <sup>{counts.get(t)}</sup>
          </button>
        ))
      }
    </div>

    <div class="wrap index__grid">
      {
        projects.map((p, i) => (
          <a
            href={`/work/${p.id}/`}
            class="card"
            data-reveal
            data-cursor="Open"
            data-form={p.data.form}
            data-seed={p.data.seed}
            data-typology={p.data.typology}
          >
            <div class:list={['card__media', covers[i] && 'card__media--photo tone']}>
              {covers[i] ? (
                <Picture
                  src={covers[i]!.src}
                  alt=""
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1200].filter((w) => w <= covers[i]!.src.width).concat(covers[i]!.src.width < 480 ? [covers[i]!.src.width] : [])}
                  sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 33vw"
                />
              ) : (
                <canvas aria-hidden="true" />
              )}
              <span class="card__tag mono">
                {covers[i] ? `${mediaCounts[i]} ${mediaCounts[i] === 1 ? 'image' : 'images'}` : 'Diagram'}
              </span>
            </div>
            <div class="card__info">
              <h2 class="card__title">
                <span class="mono card__num">{String(i + 1).padStart(2, '0')}</span>
                {p.data.title}
              </h2>
              <p class="card__meta mono">
                {roleOf(p).firm} · {p.data.location} · {p.data.years}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<script>
  import { SnapshotRenderer, reducedMotion, type Form, type Stage } from '../../scripts/massing';

  const allCards = [...document.querySelectorAll<HTMLElement>('.card')];
  const cards = allCards.filter((c) => c.querySelector('canvas'));
  const snap = new SnapshotRenderer();
  const palette = { fg: 0x050505, bg: 0xe9e9e5 };
  const still = reducedMotion();

  const stageFor = (card: HTMLElement) =>
    snap.stage(card.dataset.form as Form, Number(card.dataset.seed), palette, 'axo', 1.1);

  const drawAll = () => {
    for (const card of cards) {
      if (card.hidden) continue;
      const stage = stageFor(card);
      stage.explode = stage.explodeTarget = 0;
      snap.draw(card.querySelector('canvas')!, stage);
    }
  };
  requestAnimationFrame(drawAll);
  let t = 0;
  addEventListener('resize', () => {
    clearTimeout(t);
    t = window.setTimeout(drawAll, 200);
  });

  // Typology filter
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      for (const card of allCards) {
        card.hidden = f !== 'all' && card.dataset.typology !== f;
        card.classList.add('is-in');
      }
      drawAll();
    });
  }

  let active: { card: HTMLElement; stage: Stage } | null = null;
  let raf = 0;
  let last = 0;
  const loop = (now: number) => {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    if (!active) return;
    snap.draw(active.card.querySelector('canvas')!, active.stage, dt);
    const settled = Math.abs(active.stage.explode - active.stage.explodeTarget) < 0.002 && active.stage.explodeTarget === 0;
    if (settled && !active.card.matches(':hover')) {
      active = null;
      raf = 0;
      return;
    }
    raf = requestAnimationFrame(loop);
  };

  if (!still) {
    for (const card of cards) {
      card.addEventListener('pointerenter', () => {
        if (active && active.card !== card) active.stage.explodeTarget = 0;
        const stage = stageFor(card);
        stage.spinSpeed = 0.5;
        stage.explodeTarget = 0.5;
        active = { card, stage };
        if (!raf) {
          last = performance.now();
          raf = requestAnimationFrame(loop);
        }
      });
      card.addEventListener('pointerleave', () => {
        const stage = stageFor(card);
        stage.explodeTarget = 0;
        stage.spinSpeed = 0;
      });
    }
  }
</script>

<style>
  .index {
    min-height: 100vh;
    padding-top: clamp(120px, 14vw, 200px);
    padding-bottom: clamp(80px, 10vw, 160px);
  }
  .index__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px 40px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line-light);
  }
  .index__title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(44px, 7vw, 128px);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }
  .index__title .serif {
    font-size: 1.1em;
  }
  .is-ready .index__title .mask > span {
    transform: none;
  }
  .index__meta {
    margin: 0;
    color: #6b6b67;
  }
  .index__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    padding-block: 18px clamp(36px, 5vw, 70px);
  }
  .index__filters button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: #6b6b67;
    background: none;
    border: 0;
    padding: 4px 0;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: color 0.3s, background-size 0.4s var(--ease);
  }
  .index__filters button:hover,
  .index__filters button[aria-pressed='true'] {
    color: var(--black);
    background-size: 100% 1px;
  }
  .index__filters sup {
    font-size: 0.8em;
    opacity: 0.6;
  }
  .index__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 80px) clamp(16px, 2vw, 32px);
  }
  .card {
    display: block;
  }
  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    max-width: 100%;
    overflow: hidden;
    background: #e9e9e5;
  }
  .card__media canvas,
  .card__media :global(picture),
  .card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__media--photo :global(img) {
    transform: scale(1.04);
  }
  .card:hover .card__media--photo :global(img) {
    filter: none;
    transform: none;
  }
  .card__tag {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 6px 9px;
    background: var(--white);
    color: var(--black);
    font-size: 10px;
  }
  .card__info {
    padding-top: 14px;
  }
  .card__title {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin: 0;
    font-weight: 500;
    font-size: clamp(20px, 1.7vw, 28px);
    letter-spacing: -0.03em;
    line-height: 1.1;
    transition: transform 0.6s var(--ease);
  }
  .card:hover .card__title {
    transform: translateX(8px);
  }
  .card__num {
    color: #6b6b67;
    flex: none;
  }
  .card__meta {
    margin: 8px 0 0;
    color: #6b6b67;
    font-size: 10px;
  }
  @media (max-width: 1100px) {
    .index__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .index__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
