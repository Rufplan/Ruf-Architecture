---
import Base from '../../layouts/Base.astro';
import { Picture } from 'astro:assets';
import { getProjects, roleOf, coverOf, mediaOf } from '../../lib/projects';

const projects = await getProjects();
const covers = projects.map((p) => coverOf(p));
const mediaCounts = projects.map((p) => mediaOf(p).length);
const years = projects.map((p) => p.data.year);
// Filter list, most common typology first.
const counts = new Map<string, number>();
for (const p of projects) counts.set(p.data.typology, (counts.get(p.data.typology) ?? 0) + 1);
const typologies = [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([t]) => t);
---

<Base title="Work" description="Projects by Rufus Kerr across commercial, residential, civic and park work.">
  <section class="index paper">
    <div class="wrap index__head">
      <h1 class="index__title">
        <span class="mask"><span>Projects</span></span>
      </h1>
      <p class="index__intro">
        Commercial, residential, hospitality and park projects, each credited to the firm it was delivered with,
        from concept design through construction.
      </p>
    </div>

    <div class="wrap index__bar mono">
      <div class="index__filters" role="group" aria-label="Filter by type">
        <button type="button" data-filter="all" aria-pressed="true">
          <span class="mark" aria-hidden="true"></span>All categories
        </button>
        {
          typologies.map((t) => (
            <button type="button" data-filter={t} aria-pressed="false">
              <span class="mark" aria-hidden="true" />
              {t}
            </button>
          ))
        }
      </div>
      <p class="index__count">({String(projects.length).padStart(2, '0')})</p>
    </div>

    <div class="wrap index__grid">
      {
        projects.map((p, i) => (
          <a href={`/work/${p.id}/`} class="card" data-reveal data-typology={p.data.typology}>
            <div class:list={['card__media', covers[i] && 'card__media--photo tone']}>
              {covers[i] ? (
                <Picture
                  src={covers[i]!.src}
                  alt=""
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1200].filter((w) => w <= covers[i]!.src.width).concat(covers[i]!.src.width < 480 ? [covers[i]!.src.width] : [])}
                  sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 33vw"
                />
              ) : (
                <span class="card__empty mono">Photography to come</span>
              )}
              {covers[i] && (
                <span class="card__tag mono">
                  {mediaCounts[i]} {mediaCounts[i] === 1 ? 'image' : 'images'}
                </span>
              )}
            </div>
            <div class="card__info">
              <h2 class="card__title">{p.data.title}</h2>
              <p class="mono card__type">
                <span class="mark" aria-hidden="true" />
                {p.data.typology}
              </p>
            </div>
            <p class="mono card__meta">
              {roleOf(p).firm} · {p.data.location} · {p.data.years}
            </p>
          </a>
        ))
      }
    </div>

    <p class="wrap index__foot mono">
      {projects.length} projects · {Math.min(...years)}–{Math.max(...years)}
    </p>
  </section>
</Base>

<script>
  // Category filter
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const count = document.querySelector<HTMLElement>('.index__count');
  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      for (const card of cards) {
        const hide = f !== 'all' && card.dataset.typology !== f;
        card.hidden = hide;
        card.classList.add('is-in');
        if (!hide) shown++;
      }
      if (count) count.textContent = `(${String(shown).padStart(2, '0')})`;
    });
  }
</script>

<style>
  .index {
    min-height: 100vh;
    padding-top: clamp(120px, 14vw, 190px);
    padding-bottom: clamp(70px, 9vw, 130px);
  }
  .index__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 20px 60px;
    padding-bottom: clamp(36px, 5vw, 70px);
  }
  .index__title {
    margin: 0 0 0 -0.03em;
    font-weight: 400;
    font-size: clamp(46px, 7vw, 120px);
    line-height: 0.92;
    letter-spacing: -0.04em;
  }
  .is-ready .index__title .mask > span {
    transform: none;
  }
  .index__intro {
    max-width: 38ch;
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #57534c;
  }

  /* Filter row: small circles, as on a printed index */
  .index__bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding-block: 14px;
    border-top: 1px solid var(--line-light);
    border-bottom: 1px solid var(--line-light);
  }
  .index__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 26px;
  }
  .index__filters button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: #8a8479;
    background: none;
    border: 0;
    padding: 2px 0;
    cursor: pointer;
    transition: color 0.3s;
  }
  .mark {
    width: 7px;
    height: 7px;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  .index__filters button:hover,
  .index__filters button[aria-pressed='true'] {
    color: var(--black);
  }
  .index__filters button[aria-pressed='true'] .mark {
    background: var(--black);
  }
  .index__count {
    margin: 0;
    color: #8a8479;
  }

  .index__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(36px, 4vw, 64px) clamp(16px, 2vw, 28px);
    padding-top: clamp(36px, 5vw, 70px);
  }
  .card {
    display: block;
  }
  /* Beats the display rule above, so filtered-out cards really do disappear */
  .card[hidden] {
    display: none;
  }
  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    max-width: 100%;
    overflow: hidden;
    background: #ded7cc;
  }
  .card__media :global(picture),
  .card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__media--photo :global(img) {
    transform: scale(1.03);
    transition: transform 1.2s var(--ease), filter 1.2s var(--ease);
  }
  .card:hover .card__media--photo :global(img) {
    filter: none;
    transform: scale(1.07);
  }
  .card__empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #8a8479;
    background: repeating-linear-gradient(135deg, transparent 0 14px, rgba(20, 18, 15, 0.05) 14px 15px);
  }
  .card__tag {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 6px 9px;
    background: var(--paper);
    color: var(--black);
    font-size: 10px;
  }
  .card__info {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-top: 14px;
  }
  .card__title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(18px, 1.5vw, 24px);
    letter-spacing: -0.025em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .card__type {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    flex: none;
    color: #8a8479;
  }
  .card__meta {
    margin: 6px 0 0;
    color: #8a8479;
    font-size: 10px;
  }
  .index__foot {
    padding-top: clamp(40px, 6vw, 80px);
    color: #8a8479;
  }

  @media (max-width: 1100px) {
    .index__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .index__grid {
      grid-template-columns: 1fr;
    }
    .index__bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>
